# ---------------------------------------------------------------------------
# Dependencies / build output
# ---------------------------------------------------------------------------
node_modules/
/build/
/dist/

# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
*.pfx
*.p12
certs/
# LAN access key (server/lanAuth.ts) if it is ever written beside the repo.
edexo-compare-lan-key.txt

# ---------------------------------------------------------------------------
# Third-party binaries — not ours to redistribute
# ---------------------------------------------------------------------------
# Sysinternals Handle, used only by scripts/list-handles-build.ps1 to find what is
# locking dist/. Its licence does not allow redistribution, so keep a local copy
# (repo root, tools\handle\, PATH, or $env:HANDLE_EXE) instead of committing it:
# https://learn.microsoft.com/sysinternals/downloads/handle
handle64.exe
handle.exe
tools/handle/

# ---------------------------------------------------------------------------
# Local user / runtime state (regenerated by the app)
# ---------------------------------------------------------------------------
edexo-compare-user-settings.json
# 19 MB merged-journal cache; rebuilt from the journal folder on demand.
.edexo-cache/
# Per-commander on-foot scan catalog; written at runtime, empty on a fresh clone.
data/foot_scanned.json
# Machine-specific Windows shortcut (absolute paths).
EDExoCompare.lnk

# ---------------------------------------------------------------------------
# Large local-only data
# ---------------------------------------------------------------------------
# 57 MB duplicate of data/species from 2026-05-04. Git is the backup now —
# delete the folder once the first push is verified.
data/species_backup_*/

# Optional: mirror of data/species/... for exomastery JSON merged into dist packs
# (see scripts/mergeDataOverlay.mjs)
/exomastery-overlay/

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.log

# ---------------------------------------------------------------------------
# Internal planning notes / agent briefs. Kept on disk for provenance, never
# published — the repository is going public and these are working documents.
# ---------------------------------------------------------------------------
/docs/archive/

# ---------------------------------------------------------------------------
# Superseded / unused local files — kept on disk, not part of the project
# ---------------------------------------------------------------------------
# An older copy of the Electron entry point. The real one is electron/main.cjs,
# which is what package.json "main" and electron-builder both point at.
/main.cjs
# Stray icon source. The build uses build/icon.ico and public/edexo-icon.png.
/icon edexo.png
# Reminder note for the code-signing certificate. Never belongs in the repo.
sign.txt
